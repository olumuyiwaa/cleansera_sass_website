# URL of the actual product (cleansera_sass_frontend) — the "Sign in" link
# in the header sends people here. Defaults to http://localhost:3000 for
# local dev if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API base used by the demo-request and support contact forms.
# Defaults to http://localhost:8000/api/v1 for local dev if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
